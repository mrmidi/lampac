	email {$ACME_EMAIL}
}

:80 {
	@allowed remote_ip 78.80.81.229
	handle @allowed {
		redir https://{$DOMAIN}:8443{uri}
	}
	handle {
		respond "Forbidden" 403
	}
}

{$DOMAIN}:8443 {
	@allowed remote_ip 78.80.81.229
	handle @allowed {
		encode zstd gzip

		# Lampac stays internal; Caddy is the public edge.
		reverse_proxy lampac:9118 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}
	handle {
		respond "Forbidden" 403
	}
}
